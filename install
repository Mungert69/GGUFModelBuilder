#!/usr/bin/env bash
set -euo pipefail

# Resolve support files relative to this script, independent of the caller.
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# Defaults
VENV_DIR="venv"
LLAMA_DIR_FROM_FLAG=""
NONINTERACTIVE=0
INSTALL_MODE="cpu"

usage() {
  cat <<'USAGE'
Usage: ./install [--llama-dir /path/to/llama.cpp] [--venv venv] [--mode cpu|gpu] [--yes]
  --llama-dir   Path to your local llama.cpp checkout (will be saved to .env)
  --venv        Virtualenv directory name (default: venv)
  --mode        PyTorch wheel type (default: cpu)
  --yes         Non-interactive; skip prompts and apt confirmations
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --llama-dir) LLAMA_DIR_FROM_FLAG="$2"; shift 2;;
    --venv) VENV_DIR="$2"; shift 2;;
    --mode) INSTALL_MODE="$2"; shift 2;;
    --yes|-y) NONINTERACTIVE=1; shift;;
    -h|--help) usage; exit 0;;
    *) echo "Unknown arg: $1"; usage; exit 1;;
  esac
done

if [[ "$INSTALL_MODE" != cpu && "$INSTALL_MODE" != gpu ]]; then
  echo "[ERROR] --mode must be cpu or gpu"
  exit 1
fi

if ! python3 -c "import venv" &>/dev/null; then
  echo "[INFO] python3-venv is not installed. Installing..."
  if [[ $NONINTERACTIVE -eq 1 ]]; then
    sudo apt update -y && sudo apt install -y python3-venv
  else
    sudo apt update && sudo apt install -y python3-venv
  fi
else
  echo "[INFO] python3-venv is already installed."
fi

echo "[1/4] Creating virtual environment at '$VENV_DIR'..."
python3 -m venv "$VENV_DIR"

echo "[2/4] Activating virtual environment..."
# shellcheck disable=SC1090
source "$VENV_DIR/bin/activate"

echo "[3/4] Upgrading pip..."
python -m pip install --upgrade pip setuptools wheel

echo "[4/4] Installing the tested conversion stack..."

# Resolve llama.cpp dir (prompt only if not provided)
if [[ -z "$LLAMA_DIR_FROM_FLAG" ]]; then
  if [[ $NONINTERACTIVE -eq 1 ]]; then
    echo "[WARN] --llama-dir not provided in non-interactive mode; installing the project conversion stack without a checkout check."
  else
    read -rp "[INPUT] Path to your llama.cpp repo (or leave blank to skip checkout validation): " LLAMA_DIR_FROM_FLAG
  fi
fi

LLAMA_DIR_TRIMMED="${LLAMA_DIR_FROM_FLAG%/}"
if [[ -n "${LLAMA_DIR_TRIMMED}" ]]; then
  if [[ ! -d "$LLAMA_DIR_TRIMMED" ]]; then
    echo "[ERROR] llama.cpp dir not found: $LLAMA_DIR_TRIMMED"
    exit 1
  fi

  # The project installer uses shared tested versions. Installing the checkout's
  # requirements here would downgrade Transformers and break LFM3 tokenizers.
  python "$SCRIPT_DIR/install_dependencies.py" --core-only --mode "$INSTALL_MODE" --llama-dir "$LLAMA_DIR_TRIMMED"

  # persist to .env so other scripts can find it
  echo "[INFO] Writing LLAMA_CPP_DIR to .env"
  touch .env
  grep -q '^LLAMA_CPP_DIR=' .env \
    && sed -i "s|^LLAMA_CPP_DIR=.*|LLAMA_CPP_DIR=$LLAMA_DIR_TRIMMED|" .env \
    || echo "LLAMA_CPP_DIR=$LLAMA_DIR_TRIMMED" >> .env
else
  python "$SCRIPT_DIR/install_dependencies.py" --core-only --mode "$INSTALL_MODE"
fi


echo "✅ Setup complete."

